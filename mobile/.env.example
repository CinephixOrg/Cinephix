# Local development: point at the backend running on your machine/codespace.
# EAS builds (preview/production) set these in eas.json to the production
# backend, https://cinephix-backend.onrender.com — never a codespace/ngrok URL.
EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:5000/api
EXPO_PUBLIC_SOCKET_URL=http://<your-lan-ip>:5000
EXPO_PUBLIC_WEB_URL=

# Crash reporting (Sentry). Optional — leave empty to keep it off.
EXPO_PUBLIC_SENTRY_DSN=
